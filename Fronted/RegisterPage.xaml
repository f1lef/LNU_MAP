<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:map="clr-namespace:Fronted"
    x:Class="Fronted.RegisterPage"
    Title="Реєстрація"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#140F24">

    <Grid>
        <ScrollView x:Name="RegisterScrollView"
                    BackgroundColor="Transparent"
                    HorizontalScrollBarVisibility="Never"
                    VerticalScrollBarVisibility="Never">

            <!-- Мінімальна висота дозволяє центрувати екран на Windows. -->
            <Grid MinimumHeightRequest="{Binding Height, Source={x:Reference RegisterScrollView}}"
                  BackgroundColor="Transparent">
                <Grid.Padding>
                    <OnPlatform x:TypeArguments="Thickness" Default="24,24,24,32">
                        <On Platform="WinUI" Value="32" />
                    </OnPlatform>
                </Grid.Padding>

                <map:ResponsiveLoginLayout
                    HorizontalOptions="Fill">
                    <map:ResponsiveLoginLayout.VerticalOptions>
                        <OnPlatform x:TypeArguments="LayoutOptions" Default="Start">
                            <On Platform="WinUI" Value="Center" />
                        </OnPlatform>
                    </map:ResponsiveLoginLayout.VerticalOptions>

                    <Grid HeightRequest="228" Grid.Row="0">
                        <map:AnimatedRegistrationBackground
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            MapZoom="1.20"
                            InputTransparent="True" />

                        <!-- М'яке затемнення нижнього краю карти. -->
                        <Border StrokeThickness="0" InputTransparent="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00140F24" Offset="0" />
                                    <GradientStop Color="#00140F24" Offset="0.68" />
                                    <GradientStop Color="#FF140F24" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"
                              VerticalOptions="Start" Margin="0,4,0,0">
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 14"
                                    BackgroundColor="White" Padding="2">
                                <Border.WidthRequest>
                                    <OnPlatform x:TypeArguments="x:Double" Default="52">
                                        <On Platform="WinUI" Value="72" />
                                    </OnPlatform>
                                </Border.WidthRequest>
                                <Border.HeightRequest>
                                    <OnPlatform x:TypeArguments="x:Double" Default="52">
                                        <On Platform="WinUI" Value="72" />
                                    </OnPlatform>
                                </Border.HeightRequest>
                                <Image Source="logo.jpg" Aspect="AspectFit" />
                            </Border>
                            <Label Grid.Column="1" Text="LNU maps"
                                   FontFamily="OpenSansSemibold"
                                   FontAttributes="Bold"
                                   TextColor="White" CharacterSpacing="0.3"
                                   VerticalOptions="Center">
                                <Label.FontSize>
                                    <OnPlatform x:TypeArguments="x:Double" Default="24">
                                        <On Platform="WinUI" Value="28" />
                                    </OnPlatform>
                                </Label.FontSize>
                            </Label>
                        </Grid>
                    </Grid>

                    <Border Grid.Row="1"
                            StrokeThickness="0" Stroke="Transparent"
                            StrokeShape="RoundRectangle 24"
                            BackgroundColor="Transparent">
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Створити акаунт"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="32" FontAttributes="Bold"
                                   TextColor="White" LineBreakMode="WordWrap"
                                   Margin="0,6,0,0" />
                            <Label Text="Зареєструйтеся, щоб переглядати свій розклад."
                                   FontSize="15" TextColor="#C4BDCF"
                                   LineBreakMode="WordWrap" Margin="0,8,0,30" />

                            <Label Text="Електронна пошта" FontSize="14"
                                   FontAttributes="Bold" TextColor="White"
                                   Margin="0,0,0,8" />
                            <Border BackgroundColor="#211A33" Stroke="#5D4B79"
                                    StrokeThickness="1" StrokeShape="RoundRectangle 16"
                                    HeightRequest="56">
                                <Entry x:Name="RegisterEmailEntry"
                                       Placeholder="Введіть електронну пошту"
                                       PlaceholderColor="#B8AFC6" TextColor="White"
                                       FontSize="15" Keyboard="Email"
                                       Margin="14,0" BackgroundColor="Transparent" />
                            </Border>

                            <Label Text="Група" FontSize="14" FontAttributes="Bold"
                                   TextColor="White" Margin="0,22,0,8" />
                            <Border BackgroundColor="#211A33" Stroke="#5D4B79"
                                    StrokeThickness="1" StrokeShape="RoundRectangle 16"
                                    HeightRequest="56">
                                <Entry x:Name="RegisterGroupEntry"
                                       Placeholder="Введіть назву групи"
                                       PlaceholderColor="#B8AFC6" TextColor="White"
                                       FontSize="15" Margin="14,0"
                                       BackgroundColor="Transparent" />
                            </Border>

                            <Label Text="Пароль" FontSize="14" FontAttributes="Bold"
                                   TextColor="White" Margin="0,22,0,8" />
                            <Border BackgroundColor="#211A33" Stroke="#5D4B79"
                                    StrokeThickness="1" StrokeShape="RoundRectangle 16"
                                    HeightRequest="56">
                                <Entry x:Name="RegisterPasswordEntry"
                                       Placeholder="Введіть пароль"
                                       PlaceholderColor="#B8AFC6" TextColor="White"
                                       FontSize="15" Margin="14,0" IsPassword="True"
                                       BackgroundColor="Transparent" />
                            </Border>

                            <Label Text="Повторіть пароль" FontSize="14"
                                   FontAttributes="Bold" TextColor="White"
                                   Margin="0,22,0,8" />
                            <Border BackgroundColor="#211A33" Stroke="#5D4B79"
                                    StrokeThickness="1" StrokeShape="RoundRectangle 16"
                                    HeightRequest="56">
                                <Entry x:Name="RegisterConfirmPasswordEntry"
                                       Placeholder="Введіть пароль ще раз"
                                       PlaceholderColor="#B8AFC6" TextColor="White"
                                       FontSize="15" Margin="14,0" IsPassword="True"
                                       BackgroundColor="Transparent" />
                            </Border>

                            <Button x:Name="RegisterButton" Text="Зареєструватися"
                                    Margin="0,28,0,0" HeightRequest="56" CornerRadius="16"
                                    BackgroundColor="White" BorderColor="White"
                                    TextColor="#140F24" FontSize="16"
                                    FontAttributes="Bold" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="6"
                                  Margin="0,20,0,0">
                                <Label Text="Вже маєш акаунт?" FontSize="13"
                                       TextColor="#C4BDCF"
                                       HorizontalTextAlignment="End"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Увійти" FontSize="13"
                                       FontAttributes="Bold" TextColor="White"
                                       TextDecorations="Underline"
                                       VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnBackToLoginTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </map:ResponsiveLoginLayout>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
