<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Fronted.RegisterPage"
    Title="Реєстрація"
    BackgroundColor="#F5F7FC"
    Shell.NavBarIsVisible="False">

    <!-- Стилі цієї сторінки -->
    <ContentPage.Resources>
        <ResourceDictionary>

            <Style TargetType="Entry">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="TextColor" Value="#25314A" />
                <Setter Property="PlaceholderColor" Value="#9AA6B8" />
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>

            <Style TargetType="Border">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Stroke" Value="#E1E6F0" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="HeightRequest" Value="56" />
                <Setter Property="Padding" Value="12,0" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="#614099" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="HeightRequest" Value="56" />
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Вміст сторінки -->
    <ScrollView>
        <Grid Padding="24">
            <VerticalStackLayout
               
                HorizontalOptions="Fill"
                VerticalOptions="Center"
                Spacing="0">

                <HorizontalStackLayout
                    Spacing="12"
                    Margin="0,0,0,24">

                    <Image
                        Source="logo.jpg"
                        WidthRequest="64"
                        HeightRequest="64"
                        Aspect="AspectFit" />

                    <Label
                        Text="LNU maps"
                        FontFamily="OpenSansSemibold"
                        FontSize="30"
                        TextColor="#614099"
                        VerticalOptions="Center" />

                </HorizontalStackLayout>

                <Label
                    Text="Створити акаунт"
                    FontSize="30"
                    FontAttributes="Bold"
                    TextColor="#17233C" />

                <Label
                    Text="Зареєструйтеся, щоб переглядати свій розклад."
                    FontSize="14"
                    TextColor="#75839D"
                    Margin="0,0,0,16" />

                <Label
                    Text="Електронна пошта"
                    FontAttributes="Bold"
                    TextColor="#25314A" />

                <Border StrokeShape="RoundRectangle 14">
                    <Entry
                        x:Name="RegisterEmailEntry"
                        Placeholder="Введіть електронну пошту"
                        Keyboard="Email" />
                </Border>

                <Label
                    Text="Пароль"
                    FontAttributes="Bold"
                    TextColor="#25314A"
                    Margin="0,12,0,0" />

                <Border StrokeShape="RoundRectangle 14">
                    <Entry
                        x:Name="RegisterPasswordEntry"
                        Placeholder="Введіть пароль"
                        IsPassword="True" />
                </Border>

                <Label
                    Text="Повторіть пароль"
                    FontAttributes="Bold"
                    TextColor="#25314A"
                    Margin="0,12,0,0" />

                <Border StrokeShape="RoundRectangle 14">
                    <Entry
                        x:Name="RegisterConfirmPasswordEntry"
                        Placeholder="Введіть пароль ще раз"
                        IsPassword="True" />
                </Border>

                <Button
                    x:Name="RegisterButton"
                    Text="Зареєструватися"
                    Margin="0,24,0,0" />

                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    Spacing="5"
                    Margin="0,16,0,0">

                    <Label
                        Text="Вже маєш акаунт?"
                        FontSize="14"
                        TextColor="#75839D" />

                    <Label
                        Text="Увійти"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="#614099"
                        TextDecorations="Underline">

                        <Label.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="OnBackToLoginTapped" />
                        </Label.GestureRecognizers>

                    </Label>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>