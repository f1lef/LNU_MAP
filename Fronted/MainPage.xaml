<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Fronted.MainPage"
    BackgroundColor="#F6F8FC"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <Grid
            Padding="24"
            MinimumHeightRequest="700">

            <!-- Форма не розтягується на весь екран -->
            <VerticalStackLayout
                MaximumWidthRequest="420"
                WidthRequest="390"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="0">

                <!-- LOGO -->
                <HorizontalStackLayout
                    Spacing="12"
                    Margin="0,0,0,60">

                    <Border
                        WidthRequest="42"
                        HeightRequest="42"
                        BackgroundColor="#315EF4"
                        StrokeThickness="0">

                        <Label
                            Text="S"
                            TextColor="White"
                            FontSize="22"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

                    </Border>

                    <Label
                        Text="Squad404"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="#17233C"
                        VerticalOptions="Center" />

                </HorizontalStackLayout>


                <!-- TITLE -->
                <Label
                    Text="Вхід у застосунок"
                    FontSize="32"
                    FontAttributes="Bold"
                    TextColor="#17233C" />

                <Label
                    Text="Увійдіть, щоб переглядати свій розклад."
                    Margin="0,8,0,48"
                    FontSize="14"
                    TextColor="#748198" />


                <!-- EMAIL -->
                <Label
                    Text="Електронна пошта"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="#25314A"
                    Margin="0,0,0,8" />

                <Border
                    x:Name="EmailBorder"
                    BackgroundColor="White"
                    Stroke="#D9E0EB"
                    StrokeThickness="1"
                    HeightRequest="56">

                    <Entry
                        x:Name="EmailEntry"
                        Placeholder="Введіть електронну пошту"
                        PlaceholderColor="#9AA6B8"
                        TextColor="#25314A"
                        FontSize="15"
                        Keyboard="Email"
                        Margin="12,0"
                        BackgroundColor="Transparent" />

                </Border>

                <Label
                    x:Name="EmailErrorLabel"
                    Text="Введіть електронну пошту"
                    FontSize="12"
                    TextColor="#D93045"
                    Margin="0,6,0,0"
                    IsVisible="False" />


                <!-- PASSWORD -->
                <Label
                    Text="Пароль"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="#25314A"
                    Margin="0,24,0,8" />

                <Border
                    x:Name="PasswordBorder"
                    BackgroundColor="White"
                    Stroke="#D9E0EB"
                    StrokeThickness="1"
                    HeightRequest="56">

                    <Entry
                        x:Name="PasswordEntry"
                        Placeholder="Введіть пароль"
                        PlaceholderColor="#9AA6B8"
                        TextColor="#25314A"
                        FontSize="15"
                        Margin="12,0"
                        IsPassword="True"
                        BackgroundColor="Transparent" />

                </Border>

                <Label
                    x:Name="PasswordErrorLabel"
                    Text="Введіть пароль"
                    FontSize="12"
                    TextColor="#D93045"
                    Margin="0,6,0,0"
                    IsVisible="False" />


                <!-- ERROR -->
                <Label
                    x:Name="LoginErrorLabel"
                    Text="Неправильна електронна пошта або пароль."
                    TextColor="#D93045"
                    FontSize="13"
                    Margin="0,20,0,0"
                    IsVisible="False" />


                <!-- BUTTON -->
                <Button
                    x:Name="LoginButton"
                    Text="Увійти"
                    Margin="0,48,0,0"
                    HeightRequest="56"
                    CornerRadius="12"
                    BackgroundColor="#315EF4"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    Clicked="OnLoginClicked" />


                <!-- LOADING -->
                <ActivityIndicator
                    x:Name="LoadingIndicator"
                    Margin="0,15,0,0"
                    Color="#315EF4"
                    IsVisible="False"
                    IsRunning="False" />

            </VerticalStackLayout>

        </Grid>
    </ScrollView>

</ContentPage>