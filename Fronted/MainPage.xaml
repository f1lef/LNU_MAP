<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:map="clr-namespace:Fronted"
    x:Class="Fronted.MainPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#140F24"
    Padding="0">

    <ContentPage.Behaviors>
        <map:AuthPageAppearance />
    </ContentPage.Behaviors>

    <Grid BackgroundColor="#140F24"
          HorizontalOptions="Fill" VerticalOptions="Fill">
        <ScrollView x:Name="LoginScrollView"
                    BackgroundColor="#140F24"
                    HorizontalOptions="Fill" VerticalOptions="Fill"
                    HorizontalScrollBarVisibility="Never"
                    VerticalScrollBarVisibility="Never">

            <!-- Темне тло заповнює всю висоту, вміст починається згори. -->
            <Grid MinimumHeightRequest="{Binding Height, Source={x:Reference LoginScrollView}}"
                  BackgroundColor="Transparent">
                <Grid.Padding>
                    <OnPlatform x:TypeArguments="Thickness" Default="24,12,24,32">
                        <On Platform="WinUI" Value="32,12,32,32" />
                    </OnPlatform>
                </Grid.Padding>

                <map:ResponsiveLoginLayout
                    HorizontalOptions="Fill" VerticalOptions="Start">

                    <Grid HeightRequest="228" Grid.Row="0">
                        <map:AnimatedMapBackground
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            MapZoom="1.20"
                            InputTransparent="True" />

                        <!-- М'яке затемнення нижнього краю карти. -->
                        <Border StrokeThickness="0" InputTransparent="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00140F24" Offset="0" />
                                    <GradientStop Color="#00140F24" Offset="0.68" />
                                    <GradientStop Color="#FF140F24" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"
                              VerticalOptions="Start" Margin="0,4,0,0">
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 14"
                                    BackgroundColor="Transparent" Padding="0">
                                <Border.WidthRequest>
                                    <OnPlatform x:TypeArguments="x:Double" Default="52">
                                        <On Platform="WinUI" Value="72" />
                                    </OnPlatform>
                                </Border.WidthRequest>
                                <Border.HeightRequest>
                                    <OnPlatform x:TypeArguments="x:Double" Default="52">
                                        <On Platform="WinUI" Value="72" />
                                    </OnPlatform>
                                </Border.HeightRequest>
                                <Image Source="logo_transparent.png" Aspect="AspectFit" />
                            </Border>
                            <Label Grid.Column="1" Text="LNU maps"
                                   FontFamily="OpenSansSemibold"
                                   FontAttributes="Bold"
                                   TextColor="White" CharacterSpacing="0.3"
                                   VerticalOptions="Center">
                                <Label.FontSize>
                                    <OnPlatform x:TypeArguments="x:Double" Default="24">
                                        <On Platform="WinUI" Value="28" />
                                    </OnPlatform>
                                </Label.FontSize>
                            </Label>
                        </Grid>
                    </Grid>

                    <Border Grid.Row="1"
                            StrokeThickness="0" Stroke="Transparent"
                            StrokeShape="RoundRectangle 24"
                            BackgroundColor="Transparent">
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Вхід" FontFamily="OpenSansSemibold"
                                   FontSize="40" FontAttributes="Bold"
                                   TextColor="White" Margin="0,6,0,0" />
                            <Label Text="Розклад і маршрут до аудиторії — в одному місці."
                                   FontSize="15" TextColor="#C4BDCF"
                                   LineBreakMode="WordWrap" Margin="0,8,0,12" />

                            <!-- Ваш логотип рухається під час введення й прикривається при показі пароля. -->
                            <map:AnimatedLoginLogo LogoSource="logo_transparent.png"
                                WidthRequest="200" HeightRequest="150"
                                HorizontalOptions="Center" Margin="0,0,0,8"
                                EmailLength="{Binding Text.Length, Source={x:Reference EmailEntry}, FallbackValue=0, TargetNullValue=0}"
                                PasswordLength="{Binding Text.Length, Source={x:Reference PasswordEntry}, FallbackValue=0, TargetNullValue=0}"
                                IsEmailFocused="{Binding IsFocused, Source={x:Reference EmailEntry}}"
                                IsPasswordFocused="{Binding IsFocused, Source={x:Reference PasswordEntry}}"
                                IsPasswordHidden="{Binding IsPassword, Source={x:Reference PasswordEntry}}" />

                            <Label Text="Електронна пошта" FontSize="14"
                                   FontAttributes="Bold" TextColor="White"
                                   Margin="0,0,0,8" />
                            <Border x:Name="EmailBorder"
                                    BackgroundColor="#211A33" Stroke="#5D4B79"
                                    StrokeThickness="1" StrokeShape="RoundRectangle 16"
                                    HeightRequest="56">
                                <Entry x:Name="EmailEntry" Placeholder="name@lnu.edu.ua"
                                       PlaceholderColor="#B8AFC6" TextColor="White"
                                       FontSize="15" Keyboard="Email"
                                       Margin="14,0" BackgroundColor="Transparent" />
                            </Border>
                            <Label x:Name="EmailErrorLabel" Text="Введіть електронну пошту"
                                   FontSize="12" TextColor="#FF8B9A"
                                   Margin="0,6,0,0" IsVisible="False" />

                            <Label Text="Пароль" FontSize="14" FontAttributes="Bold"
                                   TextColor="White" Margin="0,22,0,8" />
                            <Border x:Name="PasswordBorder"
                                    BackgroundColor="#211A33" Stroke="#5D4B79"
                                    StrokeThickness="1" StrokeShape="RoundRectangle 16"
                                    HeightRequest="56">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Entry x:Name="PasswordEntry" Placeholder="Ваш пароль"
                                           PlaceholderColor="#B8AFC6" TextColor="White"
                                           FontSize="15" Margin="14,0" IsPassword="True"
                                           BackgroundColor="Transparent" />
                                    <map:PasswordRevealButton Grid.Column="1"
                                        HeightRequest="44" Margin="0,6,8,6"
                                        IsPasswordHidden="{Binding IsPassword, Source={x:Reference PasswordEntry}, Mode=TwoWay}" />
                                </Grid>
                            </Border>
                            <Label x:Name="PasswordErrorLabel" Text="Введіть пароль"
                                   FontSize="12" TextColor="#FF8B9A"
                                   Margin="0,6,0,0" IsVisible="False" />
                            <Label x:Name="LoginErrorLabel"
                                   Text="Неправильна електронна пошта або пароль."
                                   TextColor="#FF8B9A" FontSize="13"
                                   Margin="0,18,0,0" IsVisible="False" />

                            <Button x:Name="LoginButton" Text="Увійти"
                                    Margin="0,28,0,0" HeightRequest="56" CornerRadius="16"
                                    BackgroundColor="White" BorderColor="White"
                                    TextColor="#140F24" FontSize="16" FontAttributes="Bold"
                                    Clicked="OnLoginClicked" />

                            <!-- Grid дозволяє тексту переноситися на вузькому екрані. -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="6" Margin="0,20,0,0">
                                <Label Text="Немає акаунта?" FontSize="13" TextColor="#C4BDCF"
                                       HorizontalTextAlignment="End" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Зареєструватися" FontSize="13"
                                       FontAttributes="Bold" TextColor="White"
                                       TextDecorations="Underline" LineBreakMode="WordWrap"
                                       VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnRegisterTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                            <ActivityIndicator x:Name="LoadingIndicator" Margin="0,16,0,0"
                                               Color="White" IsVisible="False" IsRunning="False" />
                        </VerticalStackLayout>
                    </Border>
                </map:ResponsiveLoginLayout>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
